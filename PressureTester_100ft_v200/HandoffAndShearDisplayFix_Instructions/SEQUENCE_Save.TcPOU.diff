+<?xml version="1.0" encoding="utf-8"?>
+<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
+  <POU Name="SEQUENCE_Save" Id="{f7130013-676b-4e8d-9025-7f1f6c3bd85e}" SpecialFunc="None">
+    <Declaration><![CDATA[PROGRAM SEQUENCE_Save
+VAR
+	state					: INT := 0;
+	
+	fbPressurize			: FB_Pressurize;
+	fbStabilize				: FB_Stabilize;
+	fbPressureHold			: FB_PressureHold;
+	fbDepressurize			: FB_Depressurize;
+	fbCyclePressureTest		: FB_CyclePressureTest;
+	fbShearTest				: FB_ShearTest;
+	fbVPPMHigh				: FB_VPPMPID;
+	fbVPPMLow				: FB_VPPMPID;
+	testVPPM				: INT;
+	testDiff				: REAL;
+	CurrentTargetPressure	: LREAL;
+	CurrentTestDuration		: TIME;
+	MinPressure				: LREAL;
+	MaxPressure				: LREAL;
+	MaxVariance				: REAL;
+	MinVariance				: REAL;
+	FillTargetPressure		: LREAL;
+	LowHighTestActive		: BOOL;
+	LowTestComplete			: BOOL;
+	RepressurizeUsed		: BOOL;
+	SequenceActive			: BOOL;
+	ShearTestActive 		: BOOL;
+	RateIncreaseTolerance	: REAL;
+	ValveOpenDetected		: BOOL;
+	TestPassed				: BOOL;
+	TestFailed				: BOOL;
+	TestPeakPress			: TIME;
+	PumpManualCmd			: BOOL;
+	HMIStartTestPH			: BOOL;
+	FailureReason			: STRING(255);
+	
+	ManualTestTimer 		: TON;
+	TestElapsedTimer 		: TON;
+	TestElapsed				: TIME;
+
+	Auto_PumpCmd			: BOOL;
+	Auto_DumpValveACmd		: BOOL;
+	Auto_DumpValveBCmd		: BOOL;
+	Auto_BleedValveACmd		: BOOL;
+	Auto_BleedValveBCmd		: BOOL;
+	Auto_PortABlockValveCmd	: BOOL;
+	Auto_PortBBlockValveCmd	: BOOL;
+	LowPressureTarget: LREAL;
+END_VAR]]></Declaration>
+    <Implementation>
+      <ST><![CDATA[ //**************************************************************
+// Function Block Calls
+//**************************************************************
+
+//******************
+// Pressurization
+//******************
+fbPressurize(Execute := state = 200,
+			Abort := bAbortSequence OR HMI_StopTest,
+			PressureA := PortACurrentPSI,
+			PressureB := PortBCurrentPSI,
+			PortA_Active := PortA_Active,
+			PortB_Active := PortB_Active,
+			MinPressure := MinPressure,
+			MaxPressure := MaxPressure,
+			FillTarget := FillTargetPressure, //CurrentTargetPressure,
+			PressureDwell := LoadedRecipe.PressStabilizeDwell,
+			IsolationDwell := T#2S,
+			AirOK := Safety_HPP1AirStatus
+);
+
+//******************
+// Stabilization
+//******************
+fbStabilize(Execute := state = 300,
+			Abort := bAbortSequence OR HMI_StopTest,
+			SystemPressure := SystemPressure,
+			TargetMinPressure := MinPressure,
+			TargetMaxPressure := MaxPressure,
+			MaxStableVariance := LoadedRecipe.MaxStableVariance,
+			MinStableVariance := LoadedRecipe.MinStableVariance,
+			StabilizeDwell := LoadedRecipe.PressStabilizeDwell,
+			TestDurationMinutes := HMI_TestDuration,
+			CheckPressureTrend := TRUE,
+			RequireProjectedPass := TRUE
+);
+
+
+//******************
+// Pressure Hold
+//******************
+fbPressureHold(
+	Execute := state = 400,
+	Abort := bAbortSequence OR HMI_StopTest,
+	SystemPressure := SystemPressure,
+	HeaderPressure := HeaderCurrentPSI,
+	TargetMinPressure := MinPressure,
+	TargetMaxPressure := MaxPressure,
+	PortAPressure := PortACurrentPSI,
+	PortBPressure := PortBCurrentPSI,
+	HoldMinPressure := fbStabilize.StableMinPressure,
+	HoldMaxPressure := fbStabilize.StableMaxPressure,
+	HoldTime := CurrentTestDuration
+);
+
+
+//******************
+// Depressurization
+//******************
+fbDepressurize(Execute := state = 800,
+			Abort := FALSE,
+			PressureA := PortACurrentPSI,
+			PressureB := PortBCurrentPSI,
+			PortA_Active := PortA_Active,
+			PortB_Active := PortB_Active,
+			SafePressure := 100.0,
+			ZeroPressure := 25.0,
+			RequireZero := TRUE,
+			Timeout := T#5M
+);
+
+
+//******************
+// Cycle Test
+//******************
+fbCyclePressureTest(Execute := state = 600,
+			Abort := bAbortSequence OR HMI_StopTest,
+			SystemPressure := SystemPressure,
+			PressureA := PortACurrentPSI,
+			PressureB := PortBCurrentPSI,
+			PortA_Active := PortA_Active,
+			PortB_Active := PortB_Active,
+			LowPressureHigh := LoadedRecipe.CycleUpperLowPressure,
+			HighPressureHigh := LoadedRecipe.CycleUpperHighPressure,
+			LowPressureLow := LoadedRecipe.CycleLowerLowPressure,
+			HighPressureLow := LoadedRecipe.CycleLowerHighPressure,
+			TargetCycleCount := LoadedRecipe.CyclePinningNumber,
+			CycleVariation := LoadedRecipe.CycleVariation,
+			HoldTime := LoadedRecipe.CyclePressureHoldTime,
+			ValveOpenDetected := ValveOpenDetected,
+			AirOK := Safety_HPP1AirStatus,
+			LowPressureTarget := (LoadedRecipe.CycleLowerLowPressure + LoadedRecipe.CycleUpperLowPressure) * 0.5,
+);
+
+
+//******************
+// Shear Test
+//******************
+fbShearTest(Execute := ShearTestActive
+					AND ((state = 200)
+					OR 	(state = 300)
+					OR 	(state = 650)),
+			Abort := bAbortSequence OR HMI_StopTest,
+			CurrentPressure := SystemPressure,
+			TargetPressure := LoadedRecipe.ShearTestPressure,
+			DropThreshold := LoadedRecipe.ShearDropThreshold,
+			DropConfirmTime := LoadedRecipe.ShearDropConfirmTime,
+			MaxTestTime := LoadedRecipe.ShearMaxTestTime,
+			AirOK := Safety_HPP1AirStatus)
+;
+
+
+//******************
+// VPPM Control - High Pressure   state = 600
+//******************
+VPPMHighActualPSI := INT_TO_LREAL(VPPMHighActualRaw) / 10.0;			
+fbVPPMHigh(Enable := fbPressurize.Pump 
+					OR (fbCyclePressureTest.Pump)
+					//OR (state = 190)
+					//OR (state = 195)
+					OR PumpManualCmd,
+	Reset := (state <> 200) AND (state <> 600),
+	HydraulicSetpoint := CurrentTargetPressure,
+	HydraulicActual := SystemPressure,
+	PneumaticActual := VPPMHighActualPSI,
+	PumpRatio := GVL.HIGH_PUMP_RATIO,
+	SetpointBias := 0.0,
+	HydraulicHighLimit := MAX_HIGH_PRESSURE_PSI,
+	PneumaticMin := 0.0,
+	PneumaticMax := 90.0,
+	Kp := 0.004,
+	Ti := SEL(state = 600, 900.0, 20.0), // 55.0 for Cycle Test
+	Td := 0.75, //  3.75 for Cycle Test
+	IntegralEnable := (state <> 600) OR (ABS(CurrentTargetPressure - SystemPressure) <= 300.0),
+	CycleTime := 0.005,
+	FilterAlpha := 0.80,
+	Deadband := 5.0,
+	MaxRiseRate := 25.0,
+	MaxFallRate := 100.0,
+	PneumaticTrackingTolerance := 3.0,
+	PneumaticTrackingDelay := T#2S,
+	EnableTrackingFault := FALSE	
+);
+
+
+//******************
+// VPPM Control - Low Pressure   (state <> 200) AND (state <> 600),
+//******************
+VPPMLowActualPSI := INT_TO_LREAL(VPPMLowActualRaw) / 10.0;			
+fbVPPMLow(Enable := fbPressurize.Pump 
+					OR (fbCyclePressureTest.Pump)
+					//OR (state = 190)
+					//OR (state = 195)
+					OR PumpManualCmd,
+	Reset := FALSE,
+	HydraulicSetpoint := CurrentTargetPressure,
+	HydraulicActual := PortACurrentPSI,
+	PneumaticActual := VPPMLowActualPSI,
+	PumpRatio := GVL.LOW_PUMP_RATIO,
+	SetpointBias := 15.0,
+	HydraulicHighLimit := 2660,
+	PneumaticMin := 0.0,
+	PneumaticMax := 90.0,
+	Kp := 0.04,
+	Ti := 400.0, //18.0
+	Td := 3.25,
+	CycleTime := 0.010,
+	FilterAlpha := 0.80,
+	Deadband := 5.0,
+	MaxRiseRate := 25.0,
+	MaxFallRate := 25.0,
+	PneumaticTrackingTolerance := 3.0,
+	PneumaticTrackingDelay := T#2S,
+	EnableTrackingFault := FALSE	
+);
+
+//**************************************************************
+// Test Elapsed Timer - Time to pressurize, perform test and depressurize.
+//**************************************************************
+TestElapsedTimer(
+		IN := SequenceActive AND NOT HMI_TestingCompleted,
+		PT := T#5H	);
+IF TestElapsedTimer.ET > DINT_TO_TIME(HMI_ExecutedTestTime) THEN
+TestElapsed := TestElapsedTimer.ET;
+HMI_ExecutedTestTime := TIME_TO_DINT(TestElapsedTimer.ET);
+END_IF
+
+
+//**************************************************************
+// Main Sequence
+//**************************************************************
+
+CASE state OF
+
+
+//******************
+// Waiting for Test
+//******************
+0:
+	HMI_StateName := 'STEP 0 - System Ready';
+	TestPassed := FALSE;
+	TestFailed := FALSE;
+	FailureReason := '';
+	LowHighTestActive := FALSE;
+	LowTestComplete := FALSE;
+	RepressurizeUsed := FALSE;
+	Auto_PumpCmd := FALSE;
+	IF NOT Safety_I_MachineIsReset THEN
+		state := 999;
+	ELSIF HMI_StartTest AND HMI_GatheringData AND bOkForHighPressureA THEN
+		HMI_Message := '';
+		state := 100;
+	ELSIF HMI_DepressurizeSystem THEN
+		state := 800;
+	END_IF
+
+
+//******************
+// Load Recipe / Select Test Type
+//******************
+100:
+	HMI_StateName := 'STEP 100 - Loading Test';
+	LOADRECIPE();
+	TestPassed := FALSE;
+	TestFailed := FALSE;
+	FailureReason := '';
+	RepressurizeUsed := FALSE;
+	HMI_HeaderEndPressureLow := 0;
+	HMI_PortAEndPressureLow := 0;
+	HMI_PortBEndPressureLow := 0;
+	HMI_HeaderEndPressureHigh := 0;
+	HMI_PortAEndPressureHigh := 0;
+	HMI_PortBEndPressureHigh := 0;
+	HMI_LowTestElapsedTime := 0;
+	HMI_HighTestElapsedTime := 0;
+
+	//******************
+	// Manual Mode Selection
+	//******************
+	IF ActiveRecipe.RecipeName = '' THEN
+		HMIStartTestPH := TRUE;
+		state := 190;	//Manual mode
+	ELSE
+	//******************
+	// Low Pressure Body Test
+	//******************
+	IF HMI_RecipeType = 'Low Pressure Test' THEN
+		LowHighTestActive := FALSE;
+		CurrentTargetPressure := LoadedRecipe.LowTestPressure;
+		CurrentTestDuration := DINT_TO_TIME(LoadedRecipe.LowTestDuration * 60000);
+		HMI_HeaderStartPressureHigh := 0;
+		HMI_PortAStartPressureHigh := 0;
+		HMI_PortBStartPressureHigh := 0;
+		HMI_HeaderEndPressureHigh := 0;
+		HMI_PortAEndPressureHigh := 0;
+		HMI_PortBEndPressureHigh := 0;
+		HMI_HeaderCurrentPressureDropHigh	:= 0;
+		HMI_PortACurrentPressureDropHigh	:= 0;
+		HMI_PortBCurrentPressureDropHigh	:= 0;
+		state := 110;
+
+
+	//******************
+	// High Pressure Body Test
+	//******************
+	ELSIF HMI_RecipeType ='High Pressure Test' THEN
+		LowHighTestActive := FALSE;
+		CurrentTargetPressure := LoadedRecipe.HighTestPressure;
+		CurrentTestDuration := DINT_TO_TIME(LoadedRecipe.HighTestDuration * 60000);
+		HMI_HeaderStartPressureLow := 0;
+		HMI_PortAStartPressureLow 	:= 0;
+		HMI_PortBStartPressureLow 	:= 0;
+		HMI_HeaderEndPressureLow 	:= 0;
+		HMI_PortAEndPressureLow 	:= 0;
+		HMI_PortBEndPressureLow 	:= 0;
+		HMI_HeaderCurrentPressureDropLow	:= 0;
+		HMI_PortACurrentPressureDropLow		:= 0;
+		HMI_PortBCurrentPressureDropLow		:= 0;
+		state := 110;
+
+
+	//******************
+	// Combined Low + High Body Test
+	//******************
+	ELSIF HMI_RecipeType = 'Low and High Pressure Test' THEN
+		LowHighTestActive := TRUE;
+		LowTestComplete := FALSE;
+		IF LowHighTestActive AND NOT LowTestComplete THEN
+			CurrentTargetPressure := LoadedRecipe.LowTestPressure;
+			CurrentTestDuration := DINT_TO_TIME(LoadedRecipe.LowTestDuration * 60000);
+		ELSE
+			CurrentTargetPressure := LoadedRecipe.HighTestPressure;
+			CurrentTestDuration := DINT_TO_TIME(LoadedRecipe.HighTestDuration * 60000);
+		END_IF
+		state := 110;
+
+		
+	//******************
+	// Shear Test
+	//******************
+	ELSIF HMI_RecipeType = 'Shear Test' THEN
+		ShearTestActive := TRUE;
+		CurrentTargetPressure := LoadedRecipe.ShearTestPressure;
+		CurrentTestDuration := LoadedRecipe.ShearMaxTestTime;
+		HMI_ShearPressure := 0;
+		HMI_ShearTime := T#0S;
+		state := 110;
+	
+
+	//******************
+	// XHBV Cycle Test
+	//******************
+	ELSIF HMI_RecipeType = 'XHBV Test' THEN
+		CurrentTargetPressure := LoadedRecipe.CycleUpperHighPressure;
+		CurrentTestDuration := LoadedRecipe.CyclePressureHoldTime;
+		state := 600;
+	ELSE
+		TestFailed := TRUE;
+		FailureReason := 'Invalid Test Recipe';
+		state := 900;
+	END_IF
+END_IF
+
+//******************
+// Calculate Test Limits
+//******************
+110:
+	HMI_StateName := 'STEP 110 - Calculate Test Parameters';
+	RepressurizeUsed := FALSE;
+	IF CurrentTargetPressure <= 0.0 THEN
+		TestFailed := TRUE;
+		FailureReason := 'Invalid Test Pressure';
+		state := 900;
+	ELSE
+
+		//******************
+		// Low Pressure Test
+		// Fixed PSI tolerance
+		//******************
+		IF CurrentTargetPressure <= 1000.0 THEN
+			MaxPressure := CurrentTargetPressure + LoadedRecipe.MaxTargetPressure;
+			MinPressure := CurrentTargetPressure - LoadedRecipe.MinTargetPressure;
+			MaxVariance := LoadedRecipe.MaxStableVariance;
+			MinVariance := LoadedRecipe.MinStableVariance;
+
+
+		//******************
+		// High Pressure Test
+		// Percentage tolerance
+		//******************
+		ELSE
+			MaxPressure := CurrentTargetPressure * (1.0 + LoadedRecipe.HighMaxTargetPressure / 100.0);
+			MinPressure := CurrentTargetPressure * (1.0 - LoadedRecipe.HighMinTargetPressure / 100.0);
+			MaxVariance := LoadedRecipe.HighMaxStableVar;
+			MinVariance := LoadedRecipe.HighMinStableVare;
+		END_IF
+
+
+		//******************
+		// Aim toward upper side of window
+		//******************
+		FillTargetPressure := CurrentTargetPressure ;
+		state := 200;
+	END_IF	
+
+//******************
+// Manual Operation
+//******************
+190:
+	HMI_StateName := 'STEP 190 - Manual Operation';
+	HMI_Message := 'Manual Controls Active';
+
+	HMI_InCycle := FALSE;
+
+	//Operator remains in full manual control here
+	ManualTestTimer(
+		IN := FALSE,
+		PT := T#0S	);
+
+	HMI_ExecutedTestTime := 0;
+	HMI_TimeRemainingInTest := TIME_TO_DINT(CurrentTestDuration);
+
+	IF HMI_StartTest OR HMIStartTestPH THEN
+		HMI_StartTest := FALSE;
+		HMIStartTestPH := FALSE;
+		//Convert operator-entered duration if HMI duration is minutes
+		CurrentTestDuration := DINT_TO_TIME(HMI_TestDuration * 60000);
+		HMI_PortAStartPressure := LREAL_TO_REAL(PortACurrentPSI);
+		HMI_PortBStartPressure := LREAL_TO_REAL(PortBCurrentPSI);
+		HMI_HeaderStartPressure := LREAL_TO_REAL(HeaderCurrentPSI);
+		HMI_InCycle := TRUE;
+
+		state := 195;
+
+	END_IF
+	
+
+//******************
+//  Manual Timed Test
+//******************
+195:
+	HMI_StateName := 'STEP 195 - Manual Test';
+	HMI_Message := 'Manual Test In Progress';
+	HMI_InCycle := TRUE;
+	ManualTestTimer(
+		IN := TRUE,
+		PT := CurrentTestDuration);
+
+	HMI_ExecutedTestTime :=	TIME_TO_DINT(ManualTestTimer.ET);
+
+	IF CurrentTestDuration >= ManualTestTimer.ET THEN
+		HMI_TimeRemainingInTest := TIME_TO_DINT(CurrentTestDuration - ManualTestTimer.ET);
+	ELSE
+		HMI_TimeRemainingInTest := 0;
+	END_IF
+
+
+	//Operator can still manually control valves/pump
+	//while this timer is running.
+	IF HMI_StopTest THEN
+		ManualTestTimer(
+			IN := FALSE,
+			PT := CurrentTestDuration);
+
+		HMI_StopTest := FALSE;
+		TestPassed := FALSE;
+		HMI_Message := 'Manual Test Stopped';
+		state := 197;
+
+	ELSIF ManualTestTimer.Q THEN
+		ManualTestTimer(
+			IN := FALSE,
+			PT := CurrentTestDuration);
+		HMI_ExecutedTestTime := TIME_TO_DINT(CurrentTestDuration);
+		HMI_TimeRemainingInTest := 0;
+		TestPassed := TRUE;
+		HMI_CycleFinished := TRUE;
+		state := 197;
+	END_IF
+	
+
+//**************************************************************
+// 197 - Manual Test Complete
+//**************************************************************
+197:
+	HMI_StateName := 'STEP 197 - Manual Test Complete';
+	HMI_InCycle := FALSE;
+	IF TestPassed THEN
+		HMI_Message := 'Manual Test Complete';
+	ELSE
+		HMI_Message := 'Manual Test Stopped';
+	END_IF
+
+	IF HMI_ReStartTest OR HMI_Continue THEN
+		HMI_ReStartTest := FALSE;
+		HMI_CycleFinished := FALSE;		
+		TestPassed := FALSE;
+		TestFailed := FALSE;
+		state := 190;
+	ELSIF HMI_DepressurizeSystem THEN
+		state := 800;
+	ELSIF HMI_FinishTest THEN
+		HMI_CycleFinished := FALSE;
+		HMI_HeaderEndPressure := LREAL_TO_REAL(HeaderCurrentPSI);
+		HMI_PortAEndPressure := LREAL_TO_REAL(PortACurrentPSI);
+		HMI_PortBEndPressure := LREAL_TO_REAL(PortBCurrentPSI);
+		HMI_HeaderEndPressureLow := LREAL_TO_REAL(HeaderCurrentPSI);
+		HMI_PortAEndPressureLow := LREAL_TO_REAL(PortACurrentPSI);
+		HMI_PortBEndPressureLow := LREAL_TO_REAL(PortBCurrentPSI);
+		HMI_FinishTest := FALSE;
+		state := 850;
+	ELSIF  HMI_StopTest THEN
+		HMI_StopTest := FALSE;
+		HMI_Message := 'Manual Test Stopped';
+		state := 850;
+	END_IF
+
+
+	
+//******************
+// Pressurize
+//******************
+200:
+	HMI_StateName := 'STEP 200 - Pressurizing System';
+	HMI_Message := 'Building Pressure';
+	DesiredPressure := CurrentTargetPressure;
+	SequenceActive := TRUE;
+	IF ShearTestActive AND fbShearTest.Done THEN
+		HMI_ShearPressure := LREAL_TO_INT(fbShearTest.ShearPressure);
+		HMI_ShearTime := fbShearTest.ShearTime;
+		TestPeakPress := fbShearTest.ShearTime;
+	TestPassed := TRUE;
+	state := 800;
+
+	ELSIF HMI_StopTest THEN
+		state := 700;
+	ELSIF fbPressurize.Error OR NOT HMI_EStopOK THEN
+		TestFailed := TRUE;
+		FailureReason := 'Failed To Build Pressure';
+		state := 900;
+	ELSIF fbPressurize.Done THEN
+		state := 300;
+	END_IF;
+	
+	
+
+//******************
+// Stabilize Pressure
+//******************
+300:
+	HMI_StateName := 'STEP 300 - Stabilizing Pressure';
+	HMI_Message := 'Waiting for Pressure to Stabilize';
+	
+	IF ShearTestActive AND fbShearTest.Done THEN
+		HMI_ShearPressure := LREAL_TO_INT(fbShearTest.ShearPressure);
+		HMI_ShearTime := fbShearTest.ShearTime;
+		TestPassed := TRUE;
+//		state := 800;
+	ELSIF HMI_StopTest THEN
+		state := 700;
+	ELSIF fbStabilize.OverPressure THEN
+		TestFailed := TRUE;
+		FailureReason := fbStabilize.FailureReason;
+		state := 900;
+
+	//******************
+	// Pressure fell below minimum
+	//******************
+//	ELSIF fbStabilize.NeedRepressurize THEN
+//		IF NOT RepressurizeUsed THEN
+//			RepressurizeUsed := TRUE;
+//			state := 200;
+//		ELSE
+//			TestFailed := TRUE;
+//			FailureReason := 'Pressure Fell Below Minimum After Repressurization';
+//			state := 900;
+//		END_IF
+	ELSIF fbStabilize.Error THEN
+		TestFailed := TRUE;
+		FailureReason := fbStabilize.FailureReason;
+		state := 900;
+
+	ELSIF fbStabilize.Done THEN
+		IF ShearTestActive THEN
+			state := 650;
+		ELSE
+			state := 400;
+		END_IF
+	END_IF
+	
+	
+//******************
+// Timed Pressure Hold
+//******************
+400:
+	HMI_StateName := 'STEP 400 - Pressure Hold';
+	HMI_Message := 'Test In Progress';
+	HMI_InCycle := TRUE;
+	SequenceActive := TRUE;
+	
+	
+	HMI_ExecutedTestTime :=	TIME_TO_DINT(fbPressureHold.ElapsedTime);
+	IF CurrentTestDuration >= fbPressureHold.ElapsedTime THEN
+		HMI_TimeRemainingInTest := TIME_TO_DINT(CurrentTestDuration - fbPressureHold.ElapsedTime);
+	ELSE
+		HMI_TimeRemainingInTest := 0;
+	END_IF
+	
+	IF CurrentTargetPressure <= PumpSwapSetpoint THEN
+		HMI_HeaderStartPressure := LREAL_TO_REAL(fbPressureHold.HeaderStartPressure);
+		HMI_HeaderEndPressure := LREAL_TO_REAL(fbPressureHold.HeaderEndPressure);
+		HMI_PortAStartPressure := LREAL_TO_REAL(fbPressureHold.PortAStartPressure);
+		HMI_PortBStartPressure := LREAL_TO_REAL(fbPressureHold.PortBStartPressure);
+		HMI_HeaderCurrentPressureDrop := LREAL_TO_REAL(fbPressureHold.CurrentHeaderPressureDrop);
+		HMI_PortACurrentPressureDrop := LREAL_TO_REAL(fbPressureHold.CurrentPressureDropA);
+		HMI_PortBCurrentPressureDrop := LREAL_TO_REAL(fbPressureHold.CurrentPressureDropB);
+		HMI_HeaderStartPressureLow := LREAL_TO_REAL(fbPressureHold.HeaderStartPressure);
+		HMI_PortAStartPressureLow := LREAL_TO_REAL(fbPressureHold.PortAStartPressure);
+		HMI_PortBStartPressureLow := LREAL_TO_REAL(fbPressureHold.PortBStartPressure);
+		HMI_HeaderCurrentPressureDropLow := LREAL_TO_REAL(fbPressureHold.CurrentHeaderPressureDrop);
+		HMI_PortACurrentPressureDropLow := LREAL_TO_REAL(fbPressureHold.CurrentPressureDropA);
+		HMI_PortBCurrentPressureDropLow := LREAL_TO_REAL(fbPressureHold.CurrentPressureDropB);
+		HMI_LowTestElapsedTime := TIME_TO_DINT(fbPressureHold.ElapsedTime);
+	ELSE
+		HMI_HeaderStartPressure := LREAL_TO_REAL(fbPressureHold.HeaderStartPressure);
+		HMI_PortAStartPressure := LREAL_TO_REAL(fbPressureHold.PortAStartPressure);
+		HMI_PortBStartPressure := LREAL_TO_REAL(fbPressureHold.PortBStartPressure);
+		HMI_HeaderCurrentPressureDrop := LREAL_TO_REAL(fbPressureHold.CurrentHeaderPressureDrop);
+		HMI_PortACurrentPressureDrop := LREAL_TO_REAL(fbPressureHold.CurrentPressureDropA);
+		HMI_PortBCurrentPressureDrop := LREAL_TO_REAL(fbPressureHold.CurrentPressureDropB);
+		HMI_HeaderStartPressureHigh := LREAL_TO_REAL(fbPressureHold.HeaderStartPressure);
+		HMI_PortAStartPressureHigh := LREAL_TO_REAL(fbPressureHold.PortAStartPressure);
+		HMI_PortBStartPressureHigh := LREAL_TO_REAL(fbPressureHold.PortBStartPressure);
+		HMI_HeaderCurrentPressureDropHigh := LREAL_TO_REAL(fbPressureHold.CurrentHeaderPressureDrop);
+		HMI_PortACurrentPressureDropHigh := LREAL_TO_REAL(fbPressureHold.CurrentPressureDropA);
+		HMI_PortBCurrentPressureDropHigh := LREAL_TO_REAL(fbPressureHold.CurrentPressureDropB);
+		HMI_HighTestElapsedTime := TIME_TO_DINT(fbPressureHold.ElapsedTime);
+	END_IF
+	
+	
+	IF HMI_StopTest THEN
+		state := 700;
+	ELSIF fbPressureHold.Error THEN
+		TestFailed := TRUE;
+		FailureReason := fbPressureHold.FailureReason;
+		state := 900;
+	ELSIF fbPressureHold.Done THEN
+		TestPassed := TRUE;
+		state := 500;
+	END_IF
+	
+	
+//******************
+// Test Stage Complete
+//******************
+500:
+	HMI_StateName := 'STEP 500 - Test Stage Complete';
+
+	//******************
+	// Combined Low -> High Test
+	//******************
+	IF LowHighTestActive AND NOT LowTestComplete THEN
+		LowTestComplete := TRUE;
+		TestPassed := FALSE;
+		CurrentTargetPressure := LoadedRecipe.HighTestPressure;
+		CurrentTestDuration := DINT_TO_TIME(LoadedRecipe.HighTestDuration * 60000);
+		HMI_HeaderEndPressureLow := LREAL_TO_REAL(fbPressureHold.HeaderPressure);
+		HMI_PortAEndPressureLow := LREAL_TO_REAL(fbPressureHold.PortAPressure);
+		HMI_PortBEndPressureLow := LREAL_TO_REAL(fbPressureHold.PortBPressure);
+		RepressurizeUsed := FALSE;
+		state := 110;
+	ELSE
+		TestPassed := TRUE;
+		IF CurrentTargetPressure <= PumpSwapSetpoint  THEN
+			HMI_HeaderEndPressureLow := LREAL_TO_REAL(fbPressureHold.HeaderPressure);
+			HMI_PortAEndPressureLow := LREAL_TO_REAL(fbPressureHold.PortAPressure);
+			HMI_PortBEndPressureLow := LREAL_TO_REAL(fbPressureHold.PortBPressure);
+		ELSE
+			HMI_HeaderEndPressureHigh := LREAL_TO_REAL(fbPressureHold.HeaderPressure);
+			HMI_PortAEndPressureHigh := LREAL_TO_REAL(fbPressureHold.PortAPressure);
+			HMI_PortBEndPressureHigh := LREAL_TO_REAL(fbPressureHold.PortBPressure);
+		END_IF
+		state := 800; 
+	END_IF
+	
+	
+//******************
+// XHBV Cycle Test
+//******************
+600:
+	HMI_StateName := 'STEP 600 - Cycle Pressure Test';
+	HMI_CycleCount := UINT_TO_INT(fbCyclePressureTest.CycleCount);
+	SequenceActive := TRUE;
+	HMI_TimeRemainingInTest := TIME_TO_DINT(fbCyclePressureTest.TimeRemaining);
+	
+	IF HMI_StopTest THEN
+		state := 700;
+	ELSIF fbCyclePressureTest.Failed THEN
+		TestFailed := TRUE;
+		FailureReason := fbCyclePressureTest.FailureReason;
+		state := 900;
+	ELSIF fbCyclePressureTest.Done THEN
+		TestPassed := TRUE;
+		state := 800;
+	END_IF
+
+
+//******************
+// Shear Test
+//******************
+650:
+	HMI_StateName := 'STEP 650 - Shear Test';
+	HMI_Message := 'Pressurizing - Waiting for Shear Event';
+	HMI_InCycle := TRUE;
+
+
+	//******************
+	// Live values
+	//******************
+	HMI_ShearPressure := LREAL_TO_INT(fbShearTest.PeakPressure);
+	HMI_ExecutedTestTime := TIME_TO_DINT(fbShearTest.ElapsedTime);
+	
+
+	//******************
+	// Operator abort
+	//******************
+	IF HMI_StopTest THEN
+		TestPassed := FALSE;
+		state := 700;
+
+
+	//******************
+	// Shear test fault / no shear
+	//******************
+	ELSIF fbShearTest.Error THEN
+		TestFailed := TRUE;
+		FailureReason := fbShearTest.FailureReason;
+		state := 900;
+
+
+	//******************
+	// Shear detected
+	//******************
+	ELSIF fbShearTest.Done THEN
+		HMI_ShearPressure := LREAL_TO_INT(fbShearTest.ShearPressure);
+		HMI_ShearTime := fbShearTest.ShearTime;
+		TestPassed := TRUE;
+		HMI_Message := 'Shear Event Detected';
+		state := 200;
+	END_IF
+
+	
+//******************
+// Operator Abort
+//******************
+700:
+	HMI_StateName := 'STEP 700 - Test Stopped';
+	HMI_Message := 'Test Cycle Stopped by Operator';
+	TestFailed := TRUE;
+	FailureReason := 'Test Cycle Stopped by Operator';
+	TestPassed := FALSE;
+	state := 800;
+	
+	
+//******************
+// Depressurize
+//******************
+800:
+	HMI_StateName := 'STEP 800 - Depressurizing';
+	IF fbDepressurize.Error THEN
+		TestFailed := TRUE;
+		FailureReason := fbDepressurize.FailureReason;
+		state := 999;
+	ELSIF fbDepressurize.Done THEN
+		HMI_Message := 'System is Depressurized';
+		state := 850;
+	ELSIF  HMI_StopTest THEN
+		HMI_StopTest := FALSE;
+		state := 850;
+	ELSE
+		HMI_Message := 'Waiting for System to Depressurize';
+	END_IF
+	
+	
+//******************
+// Test Complete
+//******************
+850:
+	HMI_StateName := 'STEP 850 - Test Complete';
+	HMI_InCycle := FALSE;
+	SequenceActive := FALSE;
+	IF TestFailed THEN
+		HMI_Message := CONCAT('Test Failed - ', FailureReason);
+	ELSE
+		HMI_Message := 'Test Complete';
+		FailureReason := 'Test Criteria Passed';
+	END_IF
+	IF HMI_GatheringData THEN
+		HMI_TestingCompleted := TRUE;
+		HMI_GatheringData := FALSE;
+		state := 875;
+	ELSE
+		HMI_InCycle := FALSE;
+		state := 0;
+	END_IF
+	
+//******************
+// Wait for Save / Finish
+//******************
+875:
+	HMI_StateName := 'STEP 875 - Waiting On Operator';
+	IF HMI_SaveTest OR HMI_StopTest OR NOT HMI_EStopOK THEN
+		HMI_TestingCompleted := FALSE;
+		HMI_SaveTest := FALSE;
+		UNLOADRECIPE();
+		HMI_ExecutedTestTime := 0;
+		state := 0;
+	END_IF
+	
+
+//******************
+// Test Failed
+//******************
+900:
+	HMI_StateName := 'STEP 900 - Test Failed';
+	TestPassed := FALSE;
+	TestFailed := TRUE;
+	HMI_Message := CONCAT('Test Failed - ', FailureReason);
+	state := 800;
+	
+	
+//******************
+// Safety Fault
+//******************
+999:
+	HMI_InCycle := FALSE;
+	SequenceActive := FALSE;
+	Auto_PumpCmd := FALSE;
+	IF NOT HMI_EStopOK THEN
+		IF NOT I_EStop1A THEN
+			HMI_Message := 'Main E-Stop pressed';
+		ELSIF NOT I_EStop2A THEN
+			HMI_Message := 'Back E-Stop pressed';
+		END_IF
+	ELSIF NOT Safety_I_EStopIsReset THEN
+		HMI_Message := 'Press Reset to begin';
+	ELSIF NOT Door1.Closed THEN
+		HMI_Message := 'Door 1 not closed';
+	ELSIF NOT Door2.Closed THEN
+		HMI_Message := 'Door 2 not closed';
+	ELSIF NOT bAirCabDoor1State THEN
+		HMI_Message := 'Air cabinet door not closed';
+	ELSE
+		HMI_Message := 'Press Reset to begin';
+	END_IF
+
+	IF Safety_I_MachineIsReset THEN
+		HMI_Message := '';
+		state := 0;
+	END_IF
+	
+	IF HMI_StopTest THEN
+		UNLOADRECIPE();
+	END_IF
+
+END_CASE
+
+
+//******************
+// Automatic Valve Setup
+//******************
+
+CASE state OF
+	200:
+		Auto_PumpCmd := fbPressurize.Pump;
+		Auto_DumpValveACmd := fbPressurize.DumpValveA;
+		Auto_DumpValveBCmd := fbPressurize.DumpValveB;
+		Auto_PortABlockValveCmd := fbPressurize.BlockValveA;
+		Auto_PortBBlockValveCmd := fbPressurize.BlockValveB;
+
+	300, 400:
+		Auto_PumpCmd := FALSE;
+		Auto_DumpValveACmd := TRUE;
+		Auto_DumpValveBCmd := TRUE;
+		Auto_PortABlockValveCmd := TRUE;
+		Auto_PortBBlockValveCmd := TRUE;
+		Auto_PumpCmd := FALSE;
+	
+
+	600:
+		Auto_PumpCmd := fbCyclePressureTest.Pump;
+		Auto_DumpValveACmd := fbCyclePressureTest.DumpValveA;
+		Auto_DumpValveBCmd := fbCyclePressureTest.DumpValveB;
+		Auto_BleedValveACmd := fbCyclePressureTest.BleedValveA;
+		Auto_BleedValveBCmd := fbCyclePressureTest.BleedValveB;
+		Auto_PortABlockValveCmd := fbCyclePressureTest.BlockValveA;
+		Auto_PortBBlockValveCmd := fbCyclePressureTest.BlockValveB;
+
+	800:
+		Auto_PumpCmd := fbDepressurize.Pump;
+		Auto_DumpValveACmd := fbDepressurize.DumpValveA;
+		Auto_DumpValveBCmd := fbDepressurize.DumpValveB;
+		Auto_PortABlockValveCmd := fbDepressurize.BlockValveA;
+		Auto_PortBBlockValveCmd := fbDepressurize.BlockValveB;
+	ELSE
+		Auto_PumpCmd := FALSE;
+		Auto_DumpValveACmd := FALSE;
+		Auto_DumpValveBCmd := FALSE;
+		Auto_BleedValveACmd := FALSE;
+		Auto_BleedValveBCmd := FALSE;
+		Auto_PortABlockValveCmd := FALSE;
+		Auto_PortBBlockValveCmd := FALSE;
+END_CASE;
+
+
+//******************
+// Final Output Selection
+//******************
+VALVES();
+
+//Bleed Valves always functional from HMI ONLY
+IF state = 600 THEN
+	O_BleedValveA := Auto_BleedValveACmd;
+ELSE
+O_BleedValveA := VALVES.HMI_BleedValveACmd;
+O_BleedValveB := VALVES.HMI_BleedValveBCmd;
+END_IF
+
+IF SequenceActive THEN
+	O_DumpValveA := Auto_DumpValveACmd;
+	O_DumpValveB := Auto_DumpValveBCmd;
+	O_PortABlockValve := Auto_PortABlockValveCmd;
+	O_PortBBlockValve := Auto_PortBBlockValveCmd;
+ELSE
+	O_DumpValveA := VALVES.HMI_DumpValveACmd;
+	O_DumpValveB := VALVES.HMI_DumpValveBCmd;
+	O_PortABlockValve := VALVES.HMI_PortABlockValveCmd;
+	O_PortBBlockValve := VALVES.HMI_PortBBlockValveCmd;
+END_IF;
+
+CASE state OF
+	0, 190, 195, 197:
+		SequenceActive := FALSE;
+END_CASE
+
+IF SequenceActive THEN
+	CASE state OF
+		200:
+			DesiredPressure := CurrentTargetPressure;
+			HMI_TestPressure := LREAL_TO_DINT(DesiredPressure);
+		ELSE
+			DesiredPressure := 0.0;
+		
+		600:
+			//Eventually cycle-test pressure command here
+			DesiredPressure := LREAL_TO_DINT(fbCyclePressureTest.DesiredPressure);	
+			HMI_TestPressure := LREAL_TO_DINT(fbCyclePressureTest.DesiredPressure);
+	END_CASE
+ELSE
+	IF HMI_TogglePump THEN
+		PumpManualCmd := NOT PumpManualCmd;
+	END_IF
+	IF PumpManualCmd AND Safety_HPP1AirStatus THEN
+		DesiredPressure := HMI_TestPressure;
+		CurrentTargetPressure := HMI_TestPressure;
+	ELSE
+		DesiredPressure := 0.0;
+	END_IF
+END_IF]]></ST>
