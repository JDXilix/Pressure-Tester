-	DesiredPressure := (LowPressureLow + LowPressureHigh) * 0.5;;
-	BleedPressureRate := fbBleedToPressure.FilteredPressureRate;
-	BleedPredictedCoastDrop := fbBleedToPressure.PredictedCoastDrop;
-	BleedDynamicClosePressure := fbBleedToPressure.DynamicClosePressure;
