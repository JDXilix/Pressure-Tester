-    ELSIF ValveOpeningCheckActive THEN
-        Pump := FALSE;
-        DesiredPressure := 0.0;
-        DumpValveA := TRUE;
-        DumpValveB := TRUE;
-        BleedValveA := TRUE;
-        BleedValveB := TRUE;
-        BlockValveA := TRUE;
-        BlockValveB := TRUE;
-
-        tHold(IN := FALSE, PT := HoldTime);
-
-    ELSE
-        tHold(IN := TRUE, PT := HoldTime);
-
-        IF tHold.Q THEN
-            tHold(IN := FALSE, PT := HoldTime);
-            State := 70;
-        END_IF;
-    END_IF;
-
-//******************
-// Completed One Pressure Cycle
-//******************
-70:
-	CycleCount := CycleCount + 1;
-	State := 80;
-
-
-//******************
-// Evaluate Cycle Count
-//******************
-80:
-	Busy := TRUE;
-
-	//******************
-	// Customer's maximum allowed cycle reached
-	// without valve opening
-	//******************
-	IF CycleCount >= MaxPassingCycle THEN
-		Failed := TRUE;
-		ErrorID := 7;
-		FailureReason := 'Valve Did Not Open Before Maximum Cycle Count';
-		State := 900;
-	ELSE
-		State := 10;
-	END_IF
-
-
-//******************
-// Test Passed
-//******************
-100:
-	Busy := FALSE;
-	Done := TRUE;
-	Passed := TRUE;
-	Failed := FALSE;
-	Pump := FALSE;
-	DumpValveA := TRUE;
-	DumpValveB := TRUE;
-	BleedValveA := TRUE;
-	BleedValveB := TRUE;
-	BlockValveA := NOT PortA_Active;
-	BlockValveB := NOT PortB_Active;
-	tHold(
-		IN := FALSE,
-		PT := HoldTime);
-
-
-//******************
-// Test Failed
-//******************
-900:
-	Busy := FALSE;
-	Done := FALSE;
-	Passed := FALSE;
-	Failed := TRUE;
-	Error := TRUE;
-	Pump := FALSE;
-	DumpValveA := TRUE;
-	DumpValveB := TRUE;
-	BleedValveA := TRUE;
-	BleedValveB := TRUE;
-	BlockValveA := NOT PortA_Active;
-	BlockValveB := NOT PortB_Active;
-	tHold(
-		IN := FALSE,
-		PT := HoldTime);
-END_CASE
-
-//**************************************************************
-// Bleed-Down Valve Opening Confirmation
-//**************************************************************
-tValveOpenBleedConfirm(IN := (State = 50) AND ValveOpenBleedCandidate,
-				PT := ValveOpenConfirmTime);
-
-IF tValveOpenBleedConfirm.Q THEN
-	ValveOpenDuringBleed := TRUE;
-END_IF;]]></ST>
