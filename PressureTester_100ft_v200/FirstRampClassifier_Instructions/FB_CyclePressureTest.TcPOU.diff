-			State := 100;
-        ELSE
-            Failed := TRUE; ErrorID := 5;
-            FailureReason := 'Valve Opened After Maximum Cycle Count';
-            State := 900;
-		END_IF
-
-
-	//******************
-	// Pressure must remain in high range during hold
-	//******************
-	    // Pressure outside high range
-    ELSIF (SystemPressure < HighPressureLow) OR (SystemPressure > HighPressureHigh) THEN
-
